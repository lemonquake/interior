script = ExtResource("1_u72xi")
metadata/studio_stats = {
"colliders": 20,
"dynamic_props": 0,
"features": ["Studio room 4.4 x 4.4 m behind a glass sliding door", "Black wedge acoustic foam on every wall and the ceiling", "Purple LED cove around the ceiling and a HARMONIK neon over the desk", "Glass sliding door (E to slide)", "Producer couch, plants, wall shelves and a pendant lamp", "Guitar wall: Ibanez, Gibson SG, Les Paul and two acoustics on hangers", "Marshall and Orange combo amps under the guitars, Fender P-bass on its stand", "Drum kit in the back corner, facing the room", "Two-tier keyboard station: 61-key synth below, analogue synth above", "Gaming / production desk: two curved monitors, RGB tower, keyboard, mouse, MIDI controller, KRK monitors"],
"models": 33,
"props": ["Couch", "Tall plant", "Wall shelves", "Encyclopedia books", "Boombox", "Alarm clock", "Brass vase", "Shelf plant", "Cassette player", "Pendant lamp", "Guitar acoustic_a", "Hanger acoustic_a", "Guitar ibanez", "Hanger ibanez", "Guitar sg", "Hanger sg", "Guitar lespaul", "Hanger lespaul", "Guitar acoustic_b", "Hanger acoustic_b", "Marshall amp", "Orange amp", "Bass on stand", "Drum kit", "Keyboard X-stand", "Synth 61-key", "Analogue synth", "Mic boom stand", "Gaming desk", "Monitor right", "Monitor left", "Gaming PC", "Keyboard", "Mouse", "MIDI controller", "Audio interface", "Gaming chair", "Speaker stand right", "KRK monitor right", "Speaker stand left", "KRK monitor left", "Headphone stand", "Headphones"],
